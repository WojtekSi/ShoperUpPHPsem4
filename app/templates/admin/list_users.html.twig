
{% extends 'base.html.twig' %}

{% block body %}
    <h1>Lista użytkowników</h1>
    <h2>Lista wszystkich użytkowników <i class="fa-solid fa-calendar-days"></i></h2>
    <table>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_edit_user', {'id': user.id}) }}">edytuj</a>
                    {% endif %}
                </td>
                <td>
                    {% if not user.admin %}
                        <form method="post" action="{{ path('admin_delete_user', {'id': user.id}) }}">
                            <input type="submit" value="usuń">
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <h1>więcej opcji:</h1>
    <button><a href ="/admin/user">Dodaj nowego użytkownika</a></button>
    <button><a href ="/admin">Wróć do panelu administratora</a></button>
{%endblock%}
