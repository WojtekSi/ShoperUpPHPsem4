{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <h1 class="text-center my-4">Panel Administratora</h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Sekcja: Najbliższe Dni #}
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h2 class="h5 m-0">Lista Najbliższych Dni <i class="fa-solid fa-calendar-days"></i></h2>
                <a href="/admin/reservation/add" class="btn btn-light btn-sm">Dodaj Rezerwację</a>
            </div>
            <div class="card-body">
                <div class="list-group">
                    {% for date in dates %}
                        <a href="{{ path('admin_reservation', { 'date': date.date }) }}" class="list-group-item list-group-item-action">
                            {{ date.date }}    
                            {% if date.reservationsCount < 4 %}
                                Liczba zajętych miejsc {{ date.reservationsCount }}
                            {% else %}
                                <span class="text-danger">Liczba zajętych miejsc {{ date.reservationsCount }}</span>
                            {% endif %}
                        </a>
                    {% else %}
                        <p class="text-muted">Brak dostępnych dat.</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Sekcja: Użytkownicy #}
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h2 class="h5 m-0">Zarządzanie Użytkownikami</h2>
            </div>
            <div class="card-body d-flex gap-2">
                <a href="/admin/users" class="btn btn-outline-primary w-100">Wyświetl Listę Użytkowników</a>
                <a href="/admin/user" class="btn btn-outline-success w-100">Dodaj Nowego Użytkownika</a>
            </div>
        </div>

        {# Sekcja: Pojazdy #}
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-dark text-white">
                <h2 class="h5 m-0">Zarządzanie Pojazdami</h2>
            </div>
            <div class="card-body d-flex gap-2">
                <a href="/admin/cars" class="btn btn-outline-primary w-100">Wyświetl Listę Pojazdów</a>
                <a href="/admin/cars/add" class="btn btn-outline-success w-100">Dodaj Nowy Pojazd</a>
            </div>
        </div>
    </div>
{% endblock %}