{% extends 'base.html.twig' %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="card shadow-sm p-4" style="max-width: 1000px; width: 100%;"> <!-- Ograniczenie szerokości i responsywność -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h1 class="h4 m-0">Lista Pojazdów</h1>
                    <h2 class="h5 mt-2">Lista wszystkich pojazdów <i class="fa-solid fa-car"></i></h2>
                </div>

                <div class="card-body">
                    <!-- Tabela z pojazdami -->
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nazwa</th>
                                    <th>Numer Rejestracyjny</th>
                                    <th>Typ</th>
                                    <th>Właściciel</th>
                                    <th>Akcje</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for car in cars %}
                                    <tr>
                                        <td>{{ car.id }}</td>
                                        <td>{{ car.name }}</td>
                                        <td>{{ car.licencePlate }}</td>
                                        <td>{{ car.type }}</td>
                                        <td>{{ car.owner.email }}</td>
                                        <td>
                                                <a href="{{ path('cars_edit', {'id': car.id}) }}" class="btn btn-warning btn-sm">
                                                    <i class="fa-solid fa-pencil-alt"></i> Edytuj
                                                </a>
                                        </td>
                                        <td>
                                            <div class="d-inline">
                                                <form id="carFormDelete_{{ car.id }}" action="{{ path('admin_cars_delete', { 'id': car.id }) }}" method="POST" class="d-inline">
                                                    <input type="hidden" name="_method" value="POST" />
                                                    <button type="submit" class="btn btn-danger btn-sm">Usuń</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <h3 class="mt-4">Więcej opcji:</h3>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/admin/cars/add" class="btn btn-success w-100 w-sm-auto">
                            <i class="fa-solid fa-plus-circle"></i> Dodaj nowy pojazd
                        </a>
                        <a href="/admin" class="btn btn-secondary w-100 w-sm-auto">
                            <i class="fa-solid fa-arrow-left"></i> Wróć do panelu administratora
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
