{% extends 'base.html.twig' %}

{% block body %}
    <div class="container my-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white text-center">
                <h1 class="h4 m-0">Edytuj Użytkownika</h1>
            </div>

            <div class="card-body">
                {# Formularz edytowania użytkownika #}
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="mb-3">
                    {{ form_widget(form) }}
                </div>
                {{ form_end(form) }}
                
                <div class="text-center mt-4">
                    <a href="/admin" class="btn btn-outline-secondary w-100 w-sm-auto">
                        <i class="fa fa-arrow-left"></i> Wróć do panelu administratora
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
