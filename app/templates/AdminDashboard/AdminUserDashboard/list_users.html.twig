{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-3">Lista użytkowników</h1>
        <h2 class="mb-4">Lista wszystkich użytkowników <i class="fa-solid fa-calendar-days"></i></h2>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_edit_user', {'id': user.id}) }}" class="btn btn-sm btn-warning">Edytuj</a>
                            {% endif %}
                            {% if not user.admin %}
                                <form method="post" action="{{ path('admin_delete_user', {'id': user.id}) }}" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Czy na pewno chcesz usunąć użytkownika?');">
                                        Usuń
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h2 class="mt-4">Więcej opcji:</h2>
        <a href="/admin/user" class="btn btn-success me-2">Dodaj nowego użytkownika</a>
        <a href="/admin" class="btn btn-secondary">Wróć do panelu administratora</a>
    </div>
{% endblock %}
