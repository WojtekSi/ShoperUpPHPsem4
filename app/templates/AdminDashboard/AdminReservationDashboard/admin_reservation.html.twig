{% extends 'base.html.twig' %}

{% block body %}
    <div class="container my-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white text-center">
                <h1 class="h4 m-0">Szczegóły Rezerwacji z dnia {{ date }}</h1>
            </div>

            <ul class="list-group list-group-flush">
                {% for place in placeIsBooked %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>{{ place.name }}</strong> 
                            <small class="text-muted">{{ place.extrainfo }}</small>
                        </div>

                        <div class="btn-group" role="group" aria-label="Akcje">
                            {% if place.isBooked %}
                                <a href="/admin/reservation/edit/{{ date }}/{{ place.id }}" class="btn btn-warning btn-sm">
                                    <i class="fa fa-edit"></i> Edytuj
                                </a>

                                <form method="post" action="{{ path('admin_reservation_delete', {'date': date, 'place_id': place.id }) }}" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Czy na pewno chcesz usunąć tę rezerwację?');">
                                        <i class="fa fa-trash"></i> Usuń
                                    </button>
                                </form>
                            {% else %}
                                <a href="/admin/reservation/add/{{ date }}/{{ place.id }}" class="btn btn-success btn-sm">
                                    <i class="fa fa-plus"></i> Dodaj
                                </a>
                            {% endif %}
                        </div>
                    </li>
                {% else %}
                    <li class="list-group-item text-center text-muted">
                        Brak dostępnych miejsc na ten dzień.
                    </li>
                {% endfor %}
            </ul>

            <div class="card-footer text-center">
                <a href="/admin" class="btn btn-outline-secondary">Wróć do Panelu</a>
            </div>
        </div>
    </div>
{% endblock %}
