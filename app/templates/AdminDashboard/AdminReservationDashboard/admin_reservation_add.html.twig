{% extends 'base.html.twig' %}

{% block body %}
    <div class="container my-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white text-center">
                <h1 class="h4 m-0">
                    {% if date is defined and date is not empty %}
                        Szczegóły Rezerwacji: {{ date }} - Miejsce: {{ placeName }}
                    {% else %}
                        Dodaj Nową Rezerwację
                    {% endif %}
                </h1>
            </div>

            <div class="card-body">
                {# Flash Messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Form #}
                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    {{ form_widget(form) }}
                {{ form_end(form) }}

                {# Powrót do panelu admina #}
                <div class="mt-3 text-center">
                    <a href="/admin" class="btn btn-outline-secondary">Wróć do Panelu</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}